Algoritmo "teste da expressão para"

Var


  vezes,numero,x,soma :inteiro
Inicio

     escreval("Quantos numeros serão digitados ?")
     leia (vezes)
     
     soma <- 0
     
     para numero de 1 ate vezes faca
     
     escreval ("Digite o numero: ")
     leia(x)
     soma <-soma + x
    fimpara
     escreval( " A soma é :", soma)
     
     

Fimalgoritmo
