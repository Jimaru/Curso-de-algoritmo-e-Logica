Var

   nota1,nota2,nota3:inteiro
   notafinal:inteiro

Inicio

    escreval("Nota da unidade 1")
    leia (nota1)
    
    escreval("Nota da unidade 2")
    leia (nota2)
    
    escreval ("NOta da unidade 3")
    leia (nota3)
    
    se nota1 < 6 entao
    escreval("reprovado")
    
    senao
    
    se nota1 >=6 entao
    escreval("Aprovado")

    
    se nota2< 6 entao
    escreval("Reprovado")

