    notafinal<-nota1+nota2+nota3
    
    escreval("Sua nota final é")
    escreval (notafinal)
    
    se notafinal < 18, entao
    escreval("REPROVADO DE ANO")
    
    senao
    
    se notafinal >=, entao
    escreval("APROVADO DE ANO")

    
    


