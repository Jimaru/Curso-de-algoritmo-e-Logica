Algoritmo "soma de inteiros"

Var

    x,soma: inteiro

Inicio

        escreva("Escreva um numero inteiro")
        leia (x)
        
       enquanto x <> 0 faca
       
       se x % 2 <> 0 entao

          x <- x+1
          fimse
          
          soma <- 5 * x + 20

          escreval ("soma=", soma)
          
          leia (x)
          
          fimenquanto

Fimalgoritmo
