algoritmo "Codigo dentro fora"

var
  X,N,i, dentro, fora: inteiro
inicio

dentro <- 0 
fora <- 0
  escreva("Quantos numeros irá digitar?")
  leia (N)

  para i de 1 ate N faca

    escreval("Digite um numero!: ")
    leia(X)

    se ((X)>=10) e ((X) <=20) entao
    dentro <- dentro + 1
    senao

    fora <- fora + 1
    fimse

  fimpara


    escreval(dentro, "Dentro")
    escreval(fora, "fora")
fimalgoritmo
