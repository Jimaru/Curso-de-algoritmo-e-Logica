Algoritmo "codigo de gasolinaa"

Var
  codigo, gasolina,alcool,diesel:inteiro


Inicio
     gasolina<-0
     diesel <-0
     alcool<-0
     
    escreval("Digite o codigo da gasolina (1 , 2 , 3 ou 4 para encerrar)")
    leia(codigo)
    
    enquanto codigo <> 4  faca

     escolha codigo
     
     caso 1
     
     alcool <- alcool+ 1
     
     caso 2
     
     gasolina <- gasolina + 1
     
     caso 3
     
     diesel <- diesel + 1
     
     fimescolha
    


      escreval("Muito obrigado!",alcool,gasolina,diesel)
      leia(codigo)
      
         fimenquanto
Fimalgoritmo
