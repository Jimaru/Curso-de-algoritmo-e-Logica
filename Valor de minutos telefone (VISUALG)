Algoritmo "semnome"



Var

     minutos:inteiro
valor:inteiro

Inicio


escreval("Digite quantos minutos de ligação você teve!:")
  leia (minutos)

   valor <-50


  se  minutos >100 entao

  valor<-valor + 2 * (minutos - 100)

  fimse

   escreval("O valor foi")


   escreval (valor)




Fimalgoritmo
