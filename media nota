Algoritmo "media nota"

Var

nota1, nota2: inteiro
       media:real

Inicio

    escreval ("Digite a primeira nota")
    leia(nota1)

    
    enquanto (nota1 <= 0 ) ou (nota1 >= 10) faca
       escreval("Nota Invalida! Tente novamente")
       leia(nota1)

fimenquanto
    


          escreval("Escreva a segunda nota")
          leia(nota2)
          
          
             enquanto (nota2 < 0 ) ou (nota2 > 10) faca
          escreval("Nota Invalida! Tente novamente")
           leia(nota2)
           

       fimenquanto
    
    
    
    media <- (nota1 + nota2) / 2
    
    escreval ("A media das notas foi de: ", media)

Fimalgoritmo
