Algoritmo "mediaidade"

Var

   idade, soma, contado : inteiro
   media : real

Inicio

   soma <- 0
   contado <- 0

   escreval("Digite as idades:")
   leia(idade)

   enquanto idade >= 0 faca

      soma <- soma + idade
      contado <- contado + 1

      leia(idade)
   fimenquanto

   se contado = 0 entao
      escreval("IMPOSSIVEL CALCULAR")
   senao
      media <- soma / contado
      escreval("MEDIA = ", media:4:2)
   fimse

Fimalgoritmo
