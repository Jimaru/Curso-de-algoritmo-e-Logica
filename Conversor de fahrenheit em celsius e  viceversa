Algoritmo "Conversor de fahrenheit"

Var
   C,F:real
   unidade:caractere


Inicio
      escreval("Voce irá digitar a temperatura em qual escala? (C/F)?")
      leia (unidade)
      
      se unidade ="F" entao
      escreval ("Digite a temperatura em Fahrenheit ")
      leia (F)
      
      C <- 5/9* (F -32)
      
      escreval("A temperatura de fahrenheit em Celsius é: ", C:4:2,"!")
       senao
      se unidade = "C" entao
      escreval ("Digite a temperatura em Celsius")
      leia (C)
      
      F <-9* C / 5 +32
      
      
      escreval(" A temperatura de Celsius em Fahrenheit é: ", F:4:2,"!")
      fimse
       fimse

Fimalgoritmo
